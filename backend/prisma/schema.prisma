generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  PM
  PL
  DEV
}

enum RepositoryProvider {
  github
  codecommit
}

// A project added from the UI (D7). Every row carries the tenant id (D2) and every query filters by it.
model Project {
  id             String                 @id @default(uuid())
  tenantId       String
  name           String
  description    String                 @default("")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  members        ProjectMember[]
  repositories   RepositoryMapping[]
  policies       ProjectPolicyVersion[]
  mcpConnections McpConnection[]
  tasks          Task[]
  runs           Run[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Work a person described for a project (D7). It keeps a copy of the repository it targeted, so changing or removing the
// connection later does not rewrite what was asked. There is no foreign key to `RepositoryMapping` for that reason.
model Task {
  id                  String             @id
  projectId           String
  title               String
  description         String
  sourceType          String
  jiraIssueKey        String?
  repositoryMappingId String
  repoProvider        RepositoryProvider
  repoName            String
  repoUrl             String
  baseBranch          String
  inputs              Json
  outputs             String[]
  createdBy           String
  createdAt           DateTime
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs                Run[]

  @@index([projectId, createdAt])
}

// One attempt at a task. `status` is validated against the state machine in code on every read and write; it is text so a
// new state needs no migration. A task has at most one run in progress (a partial unique index, see the migration).
model Run {
  id             String     @id
  projectId      String
  taskId         String
  attempt        Int
  status         String
  publishes      Boolean
  idempotencyKey String
  correlationId  String
  requestedBy    String
  createdAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  failureReason  String?
  blockedReason  String?
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events         RunEvent[]

  @@unique([projectId, idempotencyKey])
  @@unique([taskId, attempt])
  @@index([projectId, status])
  @@index([projectId, createdAt])
}

// Append only: the history of a run, numbered 1, 2, 3 … without gaps, so a client can resume after the last number it saw.
model RunEvent {
  runId   String
  seq     Int
  id      String
  type    String
  payload Json
  at      DateTime
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, seq])
}

// Role of a user inside one project only (D12). `userId` is the id the authenticator gives; there is no users table yet.
model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// One saved state of a project's editable policy (D10). Rows are only ever added, so the table is the audit trail.
// Version 0 (the default policy) is not stored. `policy` is validated again when read.
model ProjectPolicyVersion {
  projectId String
  version   Int
  policy    Json
  changedBy String
  comment   String   @default("")
  createdAt DateTime
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, version])
}

// A remote MCP server connected to a project (D9, D11). `secretRef` points at the encrypted token in `Secret`; the token is
// never stored here. No foreign key to `Secret`: the two belong to different contexts, and removal is done by the use case.
model McpConnection {
  id        String   @id
  projectId String
  name      String
  url       String
  secretRef String?
  createdBy String
  createdAt DateTime
  updatedAt DateTime
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

// An encrypted secret (AES-256-GCM). Only ciphertext is stored; the key lives in the environment, never in the database.
model Secret {
  id         String   @id
  tenantId   String
  iv         Bytes
  ciphertext Bytes
  authTag    Bytes
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// A repository connected to a project and the branches a run may start from (D7). Never holds credentials.
model RepositoryMapping {
  id              String             @id
  projectId       String
  provider        RepositoryProvider
  name            String
  url             String
  defaultBranch   String
  allowedBranches String[]
  createdAt       DateTime           @default(now())
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, name])
  @@index([projectId])
}
